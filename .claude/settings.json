{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(mvnw.cmd test *)",
      "Bash(mvnw.cmd verify *)",
      "Bash(mvnw.cmd clean verify *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(docker compose down -v *)",
      "Bash(DROP DATABASE *)",
      "Bash(mysql * -e \"DROP *)"
    ]
  }
}
