# ReferralPro Environment Configuration Template
# Copy this file to .env and update with your actual values
# .env is git-ignored and should NEVER be committed to version control

# ============================================================================
# Database Configuration
# ============================================================================
# For local development with Docker Compose, use the internal MySQL service:
DATABASE_URL=jdbc:mysql://mysql:3306/referral_platform?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USER=referral_user
DATABASE_PASSWORD=referral_pass

# For production or external database, replace with your actual connection string:
# DATABASE_URL=jdbc:mysql://your-db-host:3306/referral_platform?useSSL=true&serverTimezone=UTC
# DATABASE_USER=your_production_user
# DATABASE_PASSWORD=your_secure_password

# ============================================================================
# JWT Configuration
# ============================================================================
# Generate a secure random secret for production (minimum 256 bits / 32 characters)
# Example generation: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-min-256-bits
JWT_EXPIRATION_MINUTES=120

# ============================================================================
# Application Configuration
# ============================================================================
# Base URL for the application (used for generating referral links)
APP_BASE_URL=http://localhost:8080

# ============================================================================
# MySQL Service Configuration (for local Docker Compose)
# ============================================================================
# These are used by the MySQL container when uncommented in docker-compose.yml
MYSQL_DATABASE=referral_platform
MYSQL_USER=referral_user
MYSQL_PASSWORD=referral_pass
MYSQL_ROOT_PASSWORD=root_pass

# ============================================================================
# Production Deployment Notes
# ============================================================================
# DO NOT use this .env file in production deployments.
# Instead, use your orchestration platform's secrets management:
# - Kubernetes: Secrets and ConfigMaps
# - Docker Swarm: Docker Secrets
# - AWS: Parameter Store or Secrets Manager
# - Azure: Key Vault
# - GCP: Secret Manager
